# =============================================================================
# OpsTrack - root example environment file
# Copy to .env and adjust values for local development with docker-compose.
# Never commit a real .env file.
# =============================================================================

# --- General ---
APP_ENV=development

# --- PostgreSQL (used by the "db" service in docker-compose.yml) ---
POSTGRES_USER=opstrack
POSTGRES_PASSWORD=opstrack
POSTGRES_DB=opstrack
POSTGRES_PORT=5432

# --- Backend (FastAPI) ---
DATABASE_URL=postgresql+psycopg2://opstrack:opstrack@db:5432/opstrack
JWT_SECRET=please-change-this-to-a-long-random-string
API_PORT=8000
LOG_LEVEL=INFO
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# --- Frontend (React + Vite) ---
VITE_API_URL=http://localhost:8000
